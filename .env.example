# Copie para .env.local e preencha com as chaves do SEU projeto Supabase.
# (.env.local está no .gitignore — nunca comitar chaves.)

# Supabase → Project Settings → API
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-public
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-SECRETA

# (opcional) string de conexão direta ao Postgres — Project Settings → Database
# usada se preferir aplicar migrações via psql/drizzle em vez do SQL Editor
DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# --- Próximas fases (ainda não usados pelo app) ---
# RESEND_API_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_APP_URL=http://localhost:3000
